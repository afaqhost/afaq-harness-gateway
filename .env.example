APP_NAME=Afaq Harness Gateway
PORT=3500
DEBUG=false
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be strong random when DEBUG=false (weak placeholders are rejected at startup)
SECRET_KEY=replace-with-a-long-random-secret-generate-with-secrets-token_urlsafe
CREDENTIALS_KEY=replace-with-a-long-random-encryption-secret-generate-with-secrets-token_urlsafe
DATABASE_URL=sqlite+aiosqlite:///./data/afaq.db
HARNESS_TIMEOUT_SECONDS=600
HARNESS_CONCURRENCY=5
HARNESS_QUEUE_MAX_WAIT=30
ALLOWED_ORIGINS=http://127.0.0.1:3500,http://localhost:3500
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ENABLED=true
SSE_HEARTBEAT_SECONDS=15
SSE_RETRY_MS=3000
# Redis for multi-replica rate limiting, history replay, job mirroring (optional — fallback to in-memory when empty/disabled)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
# Optional: override default gateway system prompt (Arabic/English bilingual default is in app/core/config.py)
# DEFAULT_SYSTEM_PROMPT=
