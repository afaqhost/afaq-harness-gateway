# Afaq Harness Gateway — environment variables
# This file contains NO secrets. Never put API keys or Harness login tokens here.

# Network binding (default: 127.0.0.1)
AHG_HOST=0.0.0.0

# Listening port (default: 3000)
AHG_PORT=3000

# Data directory for SQLite databases (default: .data)
AHG_DATA_DIR=/data
